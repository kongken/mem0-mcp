# Mem0 OSS API base URL (no trailing path)
MEM0_API_URL=http://localhost:8888

# Default memory scope injected into every tool call
MEM0_DEFAULT_USER_ID=alice

# HTTP listen settings
HOST=127.0.0.1
PORT=8080
MCP_HTTP_PATH=/mcp

# Optional
# MEM0_REQUEST_TIMEOUT_MS=30000
# MCP_STATELESS=false
# MCP_ALLOWED_HOSTS=localhost,mem0.example
# LOG_LEVEL=info

# Do NOT put API keys here. Clients send X-API-Key on each MCP request.
