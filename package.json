{
  "name": "mem0-mcp",
  "version": "0.2.0",
  "description": "Streamable HTTP MCP adapter for self-hosted Mem0 OSS",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
